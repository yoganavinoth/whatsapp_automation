        "jsCode": "const today = new Date();\nconst day = today.getDay(); // 0 = Sunday, 6 = Saturday\n\nlet meetLink = \"https://meet.google.com/your-default-link\";\n\ntry {\n  const calendarLink = $node[\"Create Google Meet\"].json.conferenceData.entryPoints[0].uri;\n  if (calendarLink) {\n    meetLink = calendarLink;\n  }\n} catch (err) {\n  // Use default link if Google Meet creation fails\n}\n\nlet message = \"\";\n\nif (day >= 1 && day <= 5) {\n  message = `👋 Hello, this is n8n Automation.\\n\\n🌞 Good morning! Wishing you a productive day ahead.\\n\\n📅 Join the daily stand-up meeting at 11:30 AM:\\n🔗 ${meetLink}`;\n} else if (day === 6) {\n  message = `✅ It's Saturday – Enjoy your weekend! No meeting today.`;\n} else if (day === 0) {\n  message = `🛌 It's Sunday – No meeting today.\\n\\n📣 Reminder: Get ready for tomorrow’s meeting at 11:30 AM.`;\n}\n\nreturn [\n  {\n    json: {\n      message: message\n    }\n  }\n];\n"
